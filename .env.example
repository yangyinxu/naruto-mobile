PORT="3765"
# Defaults to ./data when omitted.
# RESEARCH_DATA_DIR="D:/Research/naruto-mobile"
# Installed Chrome is used by default; no extra browser download is needed.
BROWSER_CHANNEL="chrome"
# Optional fallback for unusual Chrome installations. Normally auto-detected.
# CHROME_USER_DATA_DIR="C:/Users/you/AppData/Local/Google/Chrome/User Data"
BROWSER_HEADLESS="false"
NO_OPEN="false"
# Optional. When omitted, a private random salt is created in the data folder.
# It only creates a backward-compatible derived deduplication key. Public UIDs
# and usernames are also retained as plain text in raw JSONL for traceability.
# RESEARCH_UID_SALT="replace-with-a-private-random-value"
