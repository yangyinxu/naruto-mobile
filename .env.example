PORT="3765"
# Packaged builds use the private server proxy with any authenticated Archtree
# account. Login happens in the app; never put account credentials or an
# OpenAI API key beside the EXE.
NARUTO_MOBILE_ANALYSIS_TRANSPORT="proxy"
NARUTO_MOBILE_PROXY_BASE_URL="https://kashewt.com/naruto-mobile/api/v1"
# Explicit source-only fallback for classifier development:
# NARUTO_MOBILE_ANALYSIS_TRANSPORT="direct"
# OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-luna"
OPENAI_REASONING_EFFORT="medium"
# Optional throughput tuning. Proxy mode clamps detail batches to 10; direct
# source development can use up to 50. Each request contains one source.
# OPENAI_BATCH_SIZE="10"
# OPENAI_CONCURRENCY="3"
# Defaults to ./data when omitted.
# RESEARCH_DATA_DIR="D:/Research/naruto-mobile"
# Installed Chrome is used by default; no extra browser download is needed.
BROWSER_CHANNEL="chrome"
# Optional fallback for unusual Chrome installations. Normally auto-detected.
# CHROME_USER_DATA_DIR="C:/Users/you/AppData/Local/Google/Chrome/User Data"
BROWSER_HEADLESS="false"
NO_OPEN="false"
# Optional. When omitted, a private random salt is created in the data folder.
# It only creates a backward-compatible derived deduplication key. Public UIDs
# and usernames are also retained as plain text in raw JSONL for traceability.
# RESEARCH_UID_SALT="replace-with-a-private-random-value"
