{
  "name": "naruto-mobile-research",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "build/electron/main.cjs",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:electron-main": "esbuild src/electron.ts --bundle --platform=node --format=cjs --target=node22 --packages=external --outfile=build/electron/main.cjs",
    "build:server": "tsc --noEmit",
    "build:web": "npm run build --workspace @naruto-mobile/web",
    "package:win": "npm run build && npm run build:electron-main && electron-builder --win portable --x64",
    "package:win:dir": "npm run build && npm run build:electron-main && electron-builder --win dir --x64",
    "dev": "tsx watch src/server.ts",
    "dev:web": "npm run dev --workspace @naruto-mobile/web",
    "start": "tsx src/server.ts",
    "test": "npm run test:server && npm run test:web",
    "test:server": "tsx --test test/**/*.test.ts",
    "test:web": "npm run test --workspace @naruto-mobile/web",
    "eval:ai": "tsx src/tools/evaluateAiClassifier.ts"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "open": "^10.2.0",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^24.3.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=24"
  },
  "build": {
    "appId": "com.yangy.naruto.feedback",
    "productName": "火影手游玩家反馈调查工具",
    "artifactName": "NarutoFeedbackResearch-${version}-portable.${ext}",
    "compression": "normal",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "build/electron/main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "web/dist",
        "to": "app/web"
      },
      {
        "from": "config",
        "to": "app/config"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
